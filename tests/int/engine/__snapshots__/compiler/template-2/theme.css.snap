/* Generated by `pnpm sections:compile` from templates/template-2: theme tokens. Do not edit. */
:root {
  --font-sans: var(--font-space-grotesk);
  --font-heading: var(--font-space-grotesk);
  --radius: 0.25rem;
  --background: oklch(98% 0.005 110deg);
  --foreground: oklch(17% 0.01 110deg);
  --card: oklch(100% 0 0deg);
  --card-foreground: oklch(17% 0.01 110deg);
  --primary: oklch(50% 0.16 135deg);
  --primary-foreground: oklch(98% 0.01 110deg);
  --secondary: oklch(93% 0.01 110deg);
  --secondary-foreground: oklch(17% 0.01 110deg);
  --muted: oklch(94% 0.008 110deg);
  --muted-foreground: oklch(45% 0.01 110deg);
  --accent: oklch(93% 0.04 125deg);
  --accent-foreground: oklch(17% 0.01 110deg);
  --border: oklch(88% 0.01 110deg);
  --input: oklch(88% 0.01 110deg);
  --ring: oklch(50% 0.16 135deg);
}

[data-theme='dark'] {
  --background: oklch(13% 0.005 110deg);
  --foreground: oklch(96% 0.01 100deg);
  --card: oklch(17% 0.006 110deg);
  --card-foreground: oklch(96% 0.01 100deg);
  --primary: oklch(90% 0.21 125deg);
  --primary-foreground: oklch(14% 0.01 110deg);
  --secondary: oklch(22% 0.008 110deg);
  --secondary-foreground: oklch(96% 0.01 100deg);
  --muted: oklch(20% 0.006 110deg);
  --muted-foreground: oklch(70% 0.01 100deg);
  --accent: oklch(25% 0.05 125deg);
  --accent-foreground: oklch(96% 0.01 100deg);
  --border: oklch(27% 0.008 110deg);
  --input: oklch(27% 0.008 110deg);
  --ring: oklch(90% 0.21 125deg);
}
