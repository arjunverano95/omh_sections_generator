/* Generated by `pnpm sections:compile` from templates/theme.yaml: theme tokens. Do not edit. */
:root {
  --font-sans: var(--font-inter);
  --font-heading: var(--font-playfair-display);
  --radius: 0.5rem;
  --background: oklch(98.5% 0.008 85deg);
  --foreground: oklch(19% 0.012 60deg);
  --card: oklch(99.5% 0.004 85deg);
  --card-foreground: oklch(19% 0.012 60deg);
  --primary: oklch(40% 0.13 260deg);
  --primary-foreground: oklch(98% 0.005 85deg);
  --secondary: oklch(94% 0.012 85deg);
  --secondary-foreground: oklch(24% 0.012 60deg);
  --muted: oklch(95% 0.01 85deg);
  --muted-foreground: oklch(46% 0.012 60deg);
  --accent: oklch(93% 0.02 255deg);
  --accent-foreground: oklch(30% 0.1 260deg);
  --border: oklch(89% 0.012 85deg);
  --input: oklch(89% 0.012 85deg);
  --ring: oklch(40% 0.13 260deg);
}

[data-theme='dark'] {
  --background: oklch(17% 0.01 60deg);
  --foreground: oklch(95% 0.008 85deg);
  --card: oklch(20% 0.01 60deg);
  --card-foreground: oklch(95% 0.008 85deg);
  --primary: oklch(72% 0.11 255deg);
  --primary-foreground: oklch(17% 0.02 260deg);
  --secondary: oklch(25% 0.01 60deg);
  --secondary-foreground: oklch(93% 0.008 85deg);
  --muted: oklch(24% 0.01 60deg);
  --muted-foreground: oklch(70% 0.01 85deg);
  --accent: oklch(28% 0.04 255deg);
  --accent-foreground: oklch(92% 0.02 255deg);
  --border: oklch(30% 0.01 60deg);
  --input: oklch(30% 0.01 60deg);
  --ring: oklch(72% 0.11 255deg);
}
